{
  "name": "nexora",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "pnpm --filter @nexora/api dev",
    "dev:web": "pnpm --filter @nexora/app dev",
    "dev:web:next": "pnpm --filter @nexora/web dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "check:lines": "bash scripts/check-line-length.sh",
    "lint:fix": "turbo lint:fix",
    "type-check": "turbo type-check",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:all": "prettier --write . && turbo lint:fix",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @nexora/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @nexora/database db:migrate:deploy",
    "db:migrate:prod:resolve-baseline-rolled-back": "pnpm --filter @nexora/database exec dotenv -e ../../.env.production -- prisma migrate resolve --rolled-back 20241201000000_baseline_init",
    "db:migrate:prod:baseline-applied": "pnpm --filter @nexora/database exec dotenv -e ../../.env.production -- prisma migrate resolve --applied 20241201000000_baseline_init",
    "db:migrate:prod:deploy": "pnpm --filter @nexora/database exec dotenv -e ../../.env.production -- prisma migrate deploy",
    "db:push": "pnpm --filter @nexora/database db:push",
    "db:push:staging": "pnpm --filter @nexora/database db:push:staging",
    "db:reset": "pnpm --filter @nexora/database db:reset",
    "db:seed": "pnpm --filter @nexora/database db:seed",
    "db:studio": "pnpm --filter @nexora/database db:studio",
    "db:generate": "pnpm --filter @nexora/database db:generate",
    "db:rls": "pnpm --filter @nexora/database db:rls",
    "clean": "turbo clean && rm -rf node_modules",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "dev:edge": "pnpm --filter @nexora/edge dev",
    "dev:edge-jobs": "pnpm --filter @nexora/edge-jobs dev",
    "dev:app": "pnpm --filter @nexora/app dev",
    "db:drizzle:check": "pnpm --filter @nexora/db db:check",
    "db:drizzle:migrate": "pnpm --filter @nexora/db db:migrate",
    "db:drizzle:parity": "pnpm --filter @nexora/db db:parity",
    "contracts:sync": "pnpm --filter @nexora/contracts sync",
    "route-parity": "node scripts/route-parity.mjs",
    "security:ungated-routes": "node scripts/security/ungated-routes.mjs",
    "security:dangerously-html": "node scripts/security/dangerously-html.mjs",
    "security:inventory": "node scripts/security/ungated-routes.mjs && node scripts/security/dangerously-html.mjs",
    "db:migrate-storage": "node packages/db/scripts/migrate-storage.mjs",
    "db:migrate-auth": "node packages/db/scripts/migrate-supabase-auth.mjs"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.23",
    "@playwright/test": "^1.62.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-next": "^15.5.23",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-immer": "^0.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-alias": "^1.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-readable-tailwind": "^3.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "eslint-plugin-zod": "^1.4.0",
    "globals": "^15.15.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "turbo": "^2.10.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "brace-expansion@<5.0.9": "5.0.9",
      "ip-address@<=10.3.0": "10.3.1",
      "postcss@<8.5.23": "8.5.23",
      "protobufjs@>=7.5.0 <=7.6.4": "7.6.5",
      "uuid@<11.1.1": "11.1.1",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "hono@<4.12.34": "4.12.34",
      "@hono/node-server@<2.0.10": "2.0.10",
      "dompurify@<=3.4.12": "3.4.13",
      "vite@<8.0.16": "8.0.16",
      "esbuild@<0.28.1": "0.28.1",
      "@opentelemetry/core@<2.8.0": "2.8.0",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "undici@>=7.0.0 <7.29.0": "7.29.0",
      "@babel/core@<=7.29.0": "7.29.6",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "sharp@<0.35.0": "0.35.0",
      "body-parser@>=2.0.0 <2.3.0": "2.3.0",
      "nanoid@<3.3.18": "3.3.18",
    "decode-uri-component@<0.5.0": "0.5.0",
    "wrangler@>=4.0.0 <4.59.1": "4.59.1",
      "socket.io-parser@>=4.0.0 <4.2.7": "4.2.7",
      "pdfjs-dist@>=6.0.0 <6.2.108": "6.2.108",
      "deepmerge-ts@<8.0.0": "8.0.1",
      "fast-uri@<3.1.6": "3.1.6",
      "qs@<6.16.0": "6.16.0",
      "@xmldom/xmldom@<0.9.12": "0.9.12",
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.4"
    },
    "patchedDependencies": {
      "expo-router": "patches/expo-router.patch"
    }
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
