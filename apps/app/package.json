{
  "name": "@nexora/app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --web --port 8081",
    "export:web": "expo export -p web && node scripts/verify-spa-bundle.mjs",
    "export:web:soft": "expo export -p web || node scripts/ensure-spa-dist.mjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "ensure-dist": "node scripts/ensure-spa-dist.mjs",
    "verify-dist": "node scripts/verify-spa-bundle.mjs"
  },
  "dependencies": {
    "@nexora/auth": "workspace:*",
    "@nexora/contracts": "workspace:*",
    "@rn-primitives/portal": "^1.5.3",
    "@rn-primitives/slot": "^1.5.2",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.0",
    "expo-linking": "~8.0.0",
    "expo-router": "~5.0.0",
    "expo-status-bar": "~3.0.0",
    "hono": "^4.10.0",
    "lucide-react-native": "^1.41.0",
    "nativewind": "4.2.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-css-interop": "0.2.6",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@expo/metro-runtime": "~5.0.4",
    "@types/node": "^22.15.0",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.0",
    "prettier-plugin-tailwindcss": "0.5.11",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
