{
  "name": "@nexora/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --env-file=../../.env.development src/main.ts",
    "build": "echo 'API uses tsx for runtime, no build needed'",
    "build:vercel": "cd ../.. && pnpm db:generate && pnpm --filter @nexora/types build && pnpm --filter @nexora/utils build",
    "start": "tsx src/main.ts",
    "start:vercel-entry": "node -e \"require('./app.js'); console.log('app.js loads OK')\"",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/genai": "^1.52.0",
    "@nexora/database": "workspace:*",
    "@nexora/i18n": "workspace:*",
    "@nexora/types": "workspace:*",
    "@nexora/utils": "workspace:*",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.112.3",
    "@types/express-serve-static-core": "^5.1.3",
    "compression": "^1.8.1",
    "cookie": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "jszip": "^3.10.1",
    "multer": "^2.2.0",
    "node-qpdf2": "^6.0.0",
    "officecrypto-tool": "^0.0.19",
    "officeparser": "^7.5.1",
    "pdf-lib": "^1.17.1",
    "posthog-node": "^5.49.0",
    "sanitize-html": "^2.17.7",
    "socket.io": "^4.8.3",
    "tsx": "^4.23.12",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nexora/eslint-config": "workspace:*",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
