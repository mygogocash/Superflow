{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "intranet-edge-jobs",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  // Long-running batch work (LLM syncs, mailbox sync, digests) — max CPU budget.
  "limits": { "cpu_ms": 300000 },
  "observability": { "enabled": true },
  // ONE trigger; src/schedule.ts decides which of the 20 jobs fire at each 10-minute tick (Asia/Bangkok).
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": { "JOBS_TIMEZONE": "Asia/Bangkok", "JOBS_ENABLED": "true" },
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000", "localConnectionString": "postgresql://postgres:dev@localhost:54330/intranet" }
  ],
  "kv_namespaces": [{ "binding": "KV_CACHE", "id": "kv-cache-local" }],
  "queues": {
    "producers": [{ "binding": "JOBS_QUEUE", "queue": "intranet-jobs-local" }],
    "consumers": [
      { "queue": "intranet-jobs-local", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3, "dead_letter_queue": "intranet-jobs-dlq-local" }
    ]
  },
  "env": {
    "staging": {
      "name": "intranet-edge-jobs-staging",
      // Keep off until EDGE_API_URL + CRON_SECRET are bound; otherwise ticks enqueue no-op / fail loudly.
      "vars": { "JOBS_TIMEZONE": "Asia/Bangkok", "JOBS_ENABLED": "false" },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "2531da29a59f4890bf8817697f5d350d" }],
      "kv_namespaces": [{ "binding": "KV_CACHE", "id": "5d4fe4fa29b34b6b8fc1f1495b66c946" }],
      "queues": {
        "producers": [{ "binding": "JOBS_QUEUE", "queue": "intranet-jobs-staging" }],
        "consumers": [{ "queue": "intranet-jobs-staging", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3, "dead_letter_queue": "intranet-jobs-dlq-staging" }]
      }
    },
    "production": {
      "name": "intranet-edge-jobs",
      // Stays disabled until cutover (Phase 9 step 2) so prod jobs never double-fire against Cloud Scheduler.
      "vars": { "JOBS_TIMEZONE": "Asia/Bangkok", "JOBS_ENABLED": "false" },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "REPLACE_WITH_PROD_HYPERDRIVE_ID" }],
      "kv_namespaces": [{ "binding": "KV_CACHE", "id": "fd822fca92e74c17a2b8a0655c97b1e5" }],
      "queues": {
        "producers": [{ "binding": "JOBS_QUEUE", "queue": "intranet-jobs-prod" }],
        "consumers": [{ "queue": "intranet-jobs-prod", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3, "dead_letter_queue": "intranet-jobs-dlq-prod" }]
      }
    }
  }
}
