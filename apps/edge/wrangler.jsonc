{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "intranet-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "limits": { "cpu_ms": 30000 },
  "observability": { "enabled": true },
  // Expo web export (apps/app) is served as static assets; API/WS/analytics paths hit the Worker first.
  "assets": {
    "directory": "../app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*", "/ingest/*", "/health"]
  },
  // Top-level = local development (wrangler dev). Real ids live under env.*.
  "vars": {
    "APP_URL": "http://localhost:8787",
    "TRUSTED_ORIGINS": "intranet://,http://localhost:8081",
    "POSTHOG_HOST": "https://us.i.posthog.com",
    "POSTHOG_ASSETS_HOST": "https://us-assets.i.posthog.com",
    "MAGIC_LINK_ALLOWED_ROLES": "",
    "CF_ACCESS_AUD": "",
    "CF_ACCESS_TEAM_DOMAIN": "",
    "AVATAR_GENERATOR_ENABLED": "true"
  },
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000", "localConnectionString": "postgresql://postgres:dev@localhost:54330/intranet" }
  ],
  "kv_namespaces": [
    { "binding": "KV_SESSIONS", "id": "kv-sessions-local" },
    { "binding": "KV_CACHE", "id": "kv-cache-local" }
  ],
  "r2_buckets": [
    { "binding": "R2_PUBLIC", "bucket_name": "intranet-local-public" },
    { "binding": "R2_PRIVATE", "bucket_name": "intranet-local-private" }
  ],
  "queues": { "producers": [{ "binding": "JOBS_QUEUE", "queue": "intranet-jobs-local" }] },
  // D1 is Worker-local sidecar state. Hyperdrive → Postgres remains the ERP SoT.
  "d1_databases": [
    {
      "binding": "EDGE_DB",
      "database_name": "intranet-edge-local",
      "database_id": "00000000-0000-0000-0000-0000000000d1",
      "migrations_dir": "../../packages/db/d1/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "PRESENCE", "class_name": "PresenceRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PresenceRoom"] }],
  "workflows": [
    { "name": "leave-approval", "binding": "LEAVE_APPROVAL", "class_name": "LeaveApprovalWorkflow" }
  ],
  "unsafe": {
    "bindings": [
      { "name": "RATE_LIMITER_LOGIN", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
      { "name": "RATE_LIMITER_GLOBAL", "type": "ratelimit", "namespace_id": "1002", "simple": { "limit": 2000, "period": 60 } }
    ]
  },
  "env": {
    "staging": {
      "name": "intranet-edge-staging",
      "vars": {
        "APP_URL": "https://staging.manut.xyz",
        "TRUSTED_ORIGINS": "intranet://",
        "POSTHOG_HOST": "https://us.i.posthog.com",
        "POSTHOG_ASSETS_HOST": "https://us-assets.i.posthog.com",
        "MAGIC_LINK_ALLOWED_ROLES": "",
        "CF_ACCESS_AUD": "",
        "CF_ACCESS_TEAM_DOMAIN": "",
        "AVATAR_GENERATOR_ENABLED": "true"
      },
      "routes": [{ "pattern": "staging.manut.xyz", "custom_domain": true }],
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "2531da29a59f4890bf8817697f5d350d" }],
      "d1_databases": [
        {
          "binding": "EDGE_DB",
          "database_name": "intranet-edge-staging",
          "database_id": "3e867fd8-351a-4aa6-8a2e-28ee54c615ea",
          "migrations_dir": "../../packages/db/d1/migrations"
        }
      ],
      "workflows": [
        { "name": "leave-approval-staging", "binding": "LEAVE_APPROVAL", "class_name": "LeaveApprovalWorkflow" }
      ],
      "kv_namespaces": [
        { "binding": "KV_SESSIONS", "id": "7974dc3228b14998888915b478220b83" },
        { "binding": "KV_CACHE", "id": "5d4fe4fa29b34b6b8fc1f1495b66c946" }
      ],
      "r2_buckets": [
        { "binding": "R2_PUBLIC", "bucket_name": "intranet-staging-public" },
        { "binding": "R2_PRIVATE", "bucket_name": "intranet-staging-private" }
      ],
      "queues": { "producers": [{ "binding": "JOBS_QUEUE", "queue": "intranet-jobs-staging" }] },
      "durable_objects": {
        "bindings": [{ "name": "PRESENCE", "class_name": "PresenceRoom" }]
      },
      // env.* does not inherit top-level `unsafe` — repeat rate-limit bindings per env.
      "unsafe": {
        "bindings": [
          { "name": "RATE_LIMITER_LOGIN", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
          { "name": "RATE_LIMITER_GLOBAL", "type": "ratelimit", "namespace_id": "1002", "simple": { "limit": 2000, "period": 60 } }
        ]
      }
    },
    "production": {
      "name": "intranet-edge",
      "vars": {
        "APP_URL": "https://manut.xyz",
        "TRUSTED_ORIGINS": "intranet://",
        "POSTHOG_HOST": "https://us.i.posthog.com",
        "POSTHOG_ASSETS_HOST": "https://us-assets.i.posthog.com",
        "MAGIC_LINK_ALLOWED_ROLES": "",
        "CF_ACCESS_AUD": "",
        "CF_ACCESS_TEAM_DOMAIN": "",
        "AVATAR_GENERATOR_ENABLED": "false"
      },
      "routes": [{ "pattern": "manut.xyz", "custom_domain": true }],
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "REPLACE_WITH_PROD_HYPERDRIVE_ID" }],
      "d1_databases": [
        {
          "binding": "EDGE_DB",
          "database_name": "intranet-edge-prod",
          "database_id": "937cd568-4171-4166-8b77-ad54e894c9da",
          "migrations_dir": "../../packages/db/d1/migrations"
        }
      ],
      "workflows": [
        { "name": "leave-approval", "binding": "LEAVE_APPROVAL", "class_name": "LeaveApprovalWorkflow" }
      ],
      "kv_namespaces": [
        { "binding": "KV_SESSIONS", "id": "3e18755143314162bafc42a7e6e50694" },
        { "binding": "KV_CACHE", "id": "fd822fca92e74c17a2b8a0655c97b1e5" }
      ],
      "r2_buckets": [
        { "binding": "R2_PUBLIC", "bucket_name": "intranet-prod-public" },
        { "binding": "R2_PRIVATE", "bucket_name": "intranet-prod-private" }
      ],
      "queues": { "producers": [{ "binding": "JOBS_QUEUE", "queue": "intranet-jobs-prod" }] },
      "durable_objects": {
        "bindings": [{ "name": "PRESENCE", "class_name": "PresenceRoom" }]
      },
      "unsafe": {
        "bindings": [
          { "name": "RATE_LIMITER_LOGIN", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
          { "name": "RATE_LIMITER_GLOBAL", "type": "ratelimit", "namespace_id": "1002", "simple": { "limit": 2000, "period": 60 } }
        ]
      }
    }
  }
}
