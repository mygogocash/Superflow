# API Vitest loads, in order: .env → .env.local → .env.test → .env.test.local (repo root).
# Use .env.test for values you only want during `pnpm --filter @nexora/api test`.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xcxuszvaqzlchupnjuyv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Supabase Shared Pooler)
DATABASE_URL="postgresql://postgres.xcxuszvaqzlchupnjuyv:[YOUR-PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xcxuszvaqzlchupnjuyv:[YOUR-PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres"

# API
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
# Secret for POST /api/cron/leave-escalation (header X-Cron-Secret or Authorization: Bearer …)
CRON_SECRET=change-me-min-8-chars

# Emails that must NEVER receive the HR-desk leave fan-out (every leave submit
# + final-approval summary), even if an admin adds them to the in-app
# recipient list. Comma / semicolon / newline separated. Use for the CEO /
# exec line. Leave unset to disable. Filtered at send time only — does not
# affect approval routing.
LEAVE_NOTIFICATION_EXCLUDE=

# Web (email deep links in API notifications)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# GCP
GCS_BUCKET=nexora-tbh-uploads
GCP_PROJECT_ID=bnii-platform-prod

# AI (Gemini — ARIA chat, receipt/invoice parse, project task generation)
GEMINI_API_KEY=your-google-ai-studio-key
# Transactional email via Resend (https://resend.com). Emails are rendered
# in-app (apps/api/src/infrastructure/email/templates.ts) and sent through
# Resend's REST API. Leave RESEND_API_KEY unset in local dev to skip sending.
RESEND_API_KEY=re_your_resend_api_key
# A Resend-verified sender (domain must be verified in the Resend dashboard).
EMAIL_FROM=Manut <noreply@manut.xyz>
# Legacy / optional — not used by current ARIA implementation
ANTHROPIC_API_KEY=

# Google Workspace OAuth (Gmail/Drive integrations)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/integrations/google/oauth-callback
# 32-byte hex (generate: openssl rand -hex 32) — encrypts stored Google tokens
INTEGRATIONS_TOKEN_KEY=

# OW2.0 traction sheet sync (Marketing → OW Dashboard). Service account JSON
# (raw or base64); share the sheet with the SA's client_email as Viewer.
GOOGLE_SHEETS_SA_KEY=
# Spreadsheet id from the sheet URL (.../spreadsheets/d/<THIS>/edit)
OW_TRACTION_SHEET_ID=
# A1 range to read, optionally tab-qualified (default A1:Z500)
OW_TRACTION_SHEET_RANGE=

# Product analytics (PostHog — US Cloud)
# Public project token — safe in the browser bundle. Same value goes to web (NEXT_PUBLIC_*) and api (POSTHOG_API_KEY).
# Get from https://us.posthog.com → Project settings → Project API key
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
# Same-origin reverse-proxy path; rewrites in apps/web/next.config.ts forward /ingest/* → us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=/ingest
POSTHOG_API_KEY=phc_your_project_key
POSTHOG_HOST=https://us.i.posthog.com
# Read access for the Workspace Usage activity tab (Phase 3). Optional — leave
# blank and the tab falls back to audit_log. Get the personal key from
# https://us.posthog.com → Settings → Personal API keys (scope: project read).
# POSTHOG_PERSONAL_API_KEY=phx_your_personal_api_key
# POSTHOG_PROJECT_ID=415423
# Opt-in flags — leave unset locally so dev traffic never reaches the prod project. Set to "1" only on staging smoke-tests.
# NEXT_PUBLIC_TELEMETRY_ENABLED=1
# TELEMETRY_ENABLED=1

# Validator Monitor — proxies `report.json` from the private
# kunanon-ui/bnry-validator-monitor repo. Fine-grained PAT with
# Contents: Read on that repo only. Generate at
# https://github.com/settings/personal-access-tokens
VALIDATOR_MONITOR_GITHUB_TOKEN=
# Optional overrides — defaults shown below
# VALIDATOR_MONITOR_REPO=kunanon-ui/bnry-validator-monitor
# VALIDATOR_MONITOR_BRANCH=main
# VALIDATOR_MONITOR_FILE=report.json

# ─── Authenticated end-to-end tests ──────────────────────────────────────
# A DEDICATED, NON-ADMIN account used only by Playwright. Never a real
# employee's login, and never the System Admin.
#
# Leave these blank here. Set them in your own environment, or as CI secrets
# (E2E_EMAIL / E2E_PASSWORD). `e2e/auth.setup.ts` fails with a message naming
# the missing variable rather than falling back to another account.
#
# See docs/pwa/PHASE_7G1_SAFE_E2E_AUTH_SETUP.md.
E2E_EMAIL=
E2E_PASSWORD=
