{
  "name": "@nexora/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./edge": "./src/edge/client.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "db:pull": "drizzle-kit pull && node scripts/post-pull.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:5432/postgres} drizzle-kit check",
    "db:baseline": "node scripts/baseline.mjs",
    "db:bootstrap-greenfield": "node scripts/bootstrap-greenfield.mjs",
    "db:seed-better-auth-admin": "node scripts/seed-better-auth-admin.mjs",
    "db:seed-project-crm-chains": "node scripts/seed-project-crm-chains.mjs",
    "db:seed-staging-proposals": "node scripts/seed-staging-proposals.mjs",
    "db:export-erp-snapshot": "node scripts/export-erp-snapshot.mjs",
    "db:parity": "node scripts/schema-parity.mjs",
    "test": "vitest run",
    "db:migrate-auth": "node scripts/migrate-supabase-auth.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@types/node": "^22.15.0"
  }
}
