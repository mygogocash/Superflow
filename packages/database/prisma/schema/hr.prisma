model VisaRecord {
  id          String    @id @default(uuid()) @db.Uuid
  // For `holderType = "employee"` (default): the employee whose visa
  // this is. For `holderType = "dependent"`: the SPONSOR employee
  // (e.g. MP's wife's record points at MP), so the existing reminder
  // cron still routes expiry emails to a Manut inbox without rewriting
  // its query path. The actual holder's display name lives in
  // `holderName`.
  employeeId  String    @map("employee_id") @db.Uuid
  /// `employee` | `dependent`
  holderType  String    @default("employee") @map("holder_type")
  /// Display name of the visa holder when `holderType = "dependent"`
  /// (the sponsor's name comes from the `employee` relation). Null
  /// for employee-type rows.
  holderName  String?   @map("holder_name")
  /// e.g. `spouse`, `child`, `parent`. Free string so HR can add
  /// values without a migration. Null when `holderType = "employee"`.
  holderRelationship String? @map("holder_relationship")
  visaType    String    @map("visa_type")
  country     String
  nationality String?
  issueDate   DateTime? @map("issue_date") @db.Date
  expiryDate  DateTime  @map("expiry_date") @db.Date
  // Work permit lives alongside the visa so HR can track both lifecycles
  // on a single record (Tanny, HR feedback May 2026). All four fields
  // remain optional — non-Thailand records often have no work permit.
  workPermitNumber     String?   @map("work_permit_number")
  workPermitIssueDate  DateTime? @map("work_permit_issue_date") @db.Date
  workPermitExpiryDate DateTime? @map("work_permit_expiry_date") @db.Date
  status      String    @default("active")
  // Legacy single-document column. New writes use `documents` (an array
  // of {name, url, type, category}) so HR can attach passport front
  // page, visa page, work permit, etc. separately. Existing rows keep
  // `documentUrl` until they're edited; the FE falls back to it when
  // `documents` is empty.
  documentUrl String?   @map("document_url")
  documents   Json      @default("[]")
  // Bookkeeping for the milestone-based reminder cron. We fire at
  // 90/60/30/14/7 day buckets (3mo, 2mo, 1mo, 2wk, 1wk) and stamp the
  // last-sent milestone here so the cron only re-pings when the record
  // crosses into a closer bucket. `lastReminderSentAt` retains the
  // wall-clock of the last dispatch for ops visibility.
  lastReminderSentAt       DateTime? @map("last_reminder_sent_at")
  lastReminderMilestoneDays Int?     @map("last_reminder_milestone_days")
  // Stamped only when `status` actually changes (never on every edit), so
  // the timeline / any SLA metric reflects the real transition moment.
  statusChangedAt DateTime? @map("status_changed_at")
  notes       String?
  entityId    String?   @map("entity_id")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  employee User    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  entity   Entity? @relation(fields: [entityId], references: [id])
  eventLogs VisaEventLog[]
  checklistItems VisaChecklistItem[]

  @@index([employeeId])
  @@index([expiryDate])
  @@index([workPermitExpiryDate])
  @@index([deletedAt])
  @@map("visa_records")
}

// Chronological per-record event log (status changes, date edits, notes,
// reminders sent, documents added). Mirrors ProjectTaskActivity. A null
// `actorId` with actorType="system" marks a cron-dispatched reminder.
model VisaEventLog {
  id           String   @id @default(uuid()) @db.Uuid
  visaRecordId String   @map("visa_record_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  actorType    String   @default("user") @map("actor_type")
  // status_change | issue_updated | expiry_updated | work_permit_updated |
  // note_added | document_added | reminder_sent | created
  kind         String
  field        String?
  oldValue     String?  @map("old_value") @db.Text
  newValue     String?  @map("new_value") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  visaRecord VisaRecord @relation(fields: [visaRecordId], references: [id], onDelete: Cascade)
  actor      User?      @relation("VisaEventLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([visaRecordId, createdAt])
  @@map("visa_event_logs")
}

// HR-curated visa/immigration knowledge base. Mirrors AriaKnowledgeArticle
// (minus the retrieval embedding) — these are directly fetched and shown
// contextually on a visa record, not semantically searched. `country` /
// `visaType` null = applies to all. `requiredPermissions` empty = visible to
// any visa reader; non-empty = caller must hold one of them.
model VisaKnowledgeArticle {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  slug        String   @unique
  body        String   @db.Text
  country     String?
  visaType    String?  @map("visa_type")
  tags        String[]
  requiredPermissions String[] @default([]) @map("required_permissions")
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by_id") @db.Uuid
  entityId    String?  @map("entity_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User? @relation("VisaKnowledgeArticleAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([country, visaType, isActive])
  @@index([slug])
  @@map("visa_knowledge_articles")
}

// Per-visa-type required-docs / process-step template. `items` is a JSON
// array of {id,label,category,optional,sortOrder}. country null = applies to
// any country for that visa type. One active template is instantiated onto a
// new record's checklist at create time.
model VisaChecklistTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  visaType  String   @map("visa_type")
  country   String?
  name      String
  items     Json     @default("[]")
  isActive  Boolean  @default(true) @map("is_active")
  entityId  String?  @map("entity_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([visaType, isActive])
  @@map("visa_checklist_templates")
}

// Per-record checklist line, instantiated from a template's items. HR ticks
// these off as documents are collected / steps completed.
model VisaChecklistItem {
  id             String    @id @default(uuid()) @db.Uuid
  visaRecordId   String    @map("visa_record_id") @db.Uuid
  // Stable id from the source template's items JSON (for traceability).
  templateItemId String    @map("template_item_id")
  label          String
  // document | step
  category       String
  optional       Boolean   @default(false)
  completed      Boolean   @default(false)
  completedAt    DateTime? @map("completed_at")
  // Actor user id (no FK — display is best-effort, attribution optional).
  completedById  String?   @map("completed_by_id") @db.Uuid
  sortOrder      Int       @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  visaRecord VisaRecord @relation(fields: [visaRecordId], references: [id], onDelete: Cascade)

  @@index([visaRecordId])
  @@map("visa_checklist_items")
}

// Thai immigration 90-day reporting (TM.47) — every foreign resident
// must report their address to Immigration within 7 days of the
// 90-day mark from their last arrival. HR wants a tracker that
// computes the due date and fires three email warnings at T-21,
// T-15, T+7 (final report day). The dispatcher is the daily cron at
// `/api/cron/ninety-day-reminders`; `lastReminderMilestoneDays` keeps
// the same milestone-stamp pattern as visa_records so a re-run never
// double-sends. Status is HR-set
// (pending / to_be_notifying / approved / no_required).
model NinetyDayNotification {
  id              String   @id @default(uuid()) @db.Uuid
  // For a `dependent` row this is the sponsor employee — they get the
  // reminder email and own the filing. For an `employee` row this is
  // the applicant themselves.
  employeeId      String   @map("employee_id") @db.Uuid
  // Office that sponsors this filing. Nullable for legacy rows that
  // pre-date the per-entity picker (migration 20260708…). Today the
  // 90-day filing is a Thailand-only obligation, but the column is
  // intentionally flexible so other offices can adopt the same view.
  entityId        String?  @map("entity_id")
  // `employee` (default — applicant = employee) or `dependent`
  // (applicant is a spouse / child / parent / other non-employee
  // whose 90-day filing we still track; sponsor employee = `employeeId`).
  holderType      String   @default("employee") @map("holder_type")
  // Free-text applicant name. Used only when `holderType = "dependent"`;
  // ignored for employee rows where the User.name is authoritative.
  holderName      String?  @map("holder_name")
  // Free-text relationship to the sponsor employee (spouse, child…).
  holderRelationship String? @map("holder_relationship")
  lastArrivalDate DateTime @map("last_arrival_date") @db.Date
  // Server-computed: lastArrivalDate + 89 days. Stored so list/filter
  // queries don't need to recompute, and so the cron can index on it.
  dueDate         DateTime @map("due_date") @db.Date
  status          String   @default("pending")
  notes           String?
  // Immigration submission receipt (PDF/image) — private `documents` bucket.
  receiptUrl      String?  @map("receipt_url")
  receiptName     String?  @map("receipt_name")
  receiptMimeType String?  @map("receipt_mime_type")
  lastReminderMilestoneDays Int?      @map("last_reminder_milestone_days")
  lastReminderSentAt        DateTime? @map("last_reminder_sent_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  employee User    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  entity   Entity? @relation(fields: [entityId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([dueDate])
  @@index([entityId])
  @@map("ninety_day_notifications")
}

model Benefit {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String?
  provider    String?
  cost        Decimal  @default(0) @db.Decimal(15, 2)
  currency    String   @default("THB")
  entityId    String?  @map("entity_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  entity      Entity?             @relation(fields: [entityId], references: [id])
  enrollments BenefitEnrollment[]

  @@map("benefits")
}

model BenefitEnrollment {
  id         String    @id @default(uuid()) @db.Uuid
  benefitId  String    @map("benefit_id")
  employeeId String    @map("employee_id") @db.Uuid
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  status     String    @default("active")

  benefit  Benefit @relation(fields: [benefitId], references: [id])
  employee User    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([benefitId, employeeId])
  @@map("benefit_enrollments")
}

// Company-wide policies / handbook documents (Code of Conduct, IT
// Policy, Travel Policy, Leave Policy, etc.). Anyone with `policy:read`
// can view + download; HR/admin with `policy:manage` can upload + edit.
// Files live in the private `documents` bucket — same signed-URL flow
// as HRMS agreements.
model CompanyPolicy {
  id            String    @id @default(uuid()) @db.Uuid
  title         String    @db.VarChar(200)
  category      String    @db.VarChar(40)
  description   String?
  fileUrl       String    @map("file_url")
  fileName      String    @map("file_name")
  mimeType      String?   @map("mime_type")
  fileSize      Int?      @map("file_size")
  version       String?   @db.VarChar(40)
  effectiveDate DateTime? @map("effective_date") @db.Date
  // Null = global / applies to every entity. Otherwise scoped to one
  // entity so India-specific handbooks don't show up for Thailand staff.
  entityId      String?   @map("entity_id")
  isActive      Boolean   @default(true) @map("is_active")
  uploadedById  String?   @map("uploaded_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  entity     Entity? @relation(fields: [entityId], references: [id])
  uploadedBy User?   @relation("CompanyPolicyUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([entityId])
  @@index([isActive])
  @@map("company_policies")
}

/// Org-wide payroll approval chain. Each row is one stage; stages execute
/// in ascending `order`. HR creates a run, then routes it through this
/// chain before flipping it to "approved" for pay-out. Each step names a
/// specific approver (CFO, COO, …) — payroll runs are HR-initiated, so
/// the submitter-conditional routing the travel chain carries isn't
/// needed here.
model PayrollApprovalStep {
  id             String   @id @default(uuid()) @db.Uuid
  order          Int      @unique
  name           String   @db.VarChar(100)
  description    String?
  approverUserId String   @map("approver_user_id") @db.Uuid
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  approverUser User @relation("PayrollApprovalStepApprover", fields: [approverUserId], references: [id], onDelete: Cascade)

  @@map("payroll_approval_steps")
}

// ─── Attendance ─────────────────────────────────────────

/// Fixed-shift policy per entity (or global default when entityId is null).
model AttendancePolicy {
  id                    String   @id @default(uuid()) @db.Uuid
  entityId              String?  @unique @map("entity_id")
  shiftStartTime        String   @default("09:00") @map("shift_start_time") @db.VarChar(5)
  shiftEndTime          String   @default("18:00") @map("shift_end_time") @db.VarChar(5)
  graceMinutes          Int      @default(15) @map("grace_minutes")
  halfDayThresholdHours Decimal  @default(4) @map("half_day_threshold_hours") @db.Decimal(4, 2)
  minimumWorkingHours   Decimal  @default(8) @map("minimum_working_hours") @db.Decimal(4, 2)
  /// JSON array of allowed work modes, e.g. ["office","remote","hybrid"]
  allowedWorkModes      Json     @default("[\"office\",\"remote\",\"hybrid\"]") @map("allowed_work_modes")
  /// JSON array of weekend day numbers (0=Sun … 6=Sat), default [0,6]
  weekendDays           Json     @default("[0,6]") @map("weekend_days")
  attendanceThresholdPct Int     @default(80) @map("attendance_threshold_pct")
  defaultTimezone       String   @default("Asia/Bangkok") @map("default_timezone") @db.VarChar(64)
  missedCheckInAfterMinutes Int  @default(120) @map("missed_check_in_after_minutes")
  missedCheckOutAfterMinutes Int @default(60) @map("missed_check_out_after_minutes")
  consecutiveAbsenceAlertDays Int @default(3) @map("consecutive_absence_alert_days")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  entity Entity? @relation(fields: [entityId], references: [id], onDelete: SetNull)

  @@map("attendance_policies")
}

/// Employee attendance correction request (regularization workflow).
model AttendanceCorrection {
  id                 String    @id @default(uuid()) @db.Uuid
  employeeId         String    @map("employee_id") @db.Uuid
  attendanceRecordId String?   @map("attendance_record_id") @db.Uuid
  attendanceDate     DateTime  @map("attendance_date") @db.Date
  correctionType     String    @map("correction_type") @db.VarChar(40)
  reason             String
  comments           String?
  status             String    @default("pending") @db.VarChar(20)
  proposedCheckIn    DateTime? @map("proposed_check_in")
  proposedCheckOut   DateTime? @map("proposed_check_out")
  proposedWorkMode   String?   @map("proposed_work_mode") @db.VarChar(20)
  approvedBy         String?   @map("approved_by") @db.Uuid
  approvedAt         DateTime? @map("approved_at")
  rejectRemarks      String?   @map("reject_remarks")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  employee User              @relation("AttendanceCorrectionEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  record   AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)
  approver User?             @relation("AttendanceCorrectionApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
  @@index([attendanceDate])
  @@map("attendance_corrections")
}

/// Configurable work shift (morning, evening, night, custom).
model AttendanceShift {
  id           String   @id @default(uuid()) @db.Uuid
  entityId     String?  @map("entity_id")
  shiftName    String   @map("shift_name") @db.VarChar(80)
  startTime    String   @map("start_time") @db.VarChar(5)
  endTime      String   @map("end_time") @db.VarChar(5)
  graceMinutes Int      @default(15) @map("grace_minutes")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  entity      Entity?                   @relation(fields: [entityId], references: [id], onDelete: SetNull)
  assignments AttendanceEmployeeShift[]

  @@index([entityId])
  @@map("attendance_shifts")
}

/// Assigns a shift to an employee for a date range.
model AttendanceEmployeeShift {
  id            String    @id @default(uuid()) @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  shiftId       String    @map("shift_id") @db.Uuid
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  employee User            @relation("AttendanceEmployeeShiftUser", fields: [employeeId], references: [id], onDelete: Cascade)
  shift    AttendanceShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([employeeId, effectiveFrom])
  @@index([shiftId])
  @@map("attendance_employee_shifts")
}

/// Approved exception days (travel, training, field work, etc.).
model AttendanceException {
  id         String    @id @default(uuid()) @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  type       String    @db.VarChar(40)
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime  @map("end_date") @db.Date
  reason     String
  status     String    @default("approved") @db.VarChar(20)
  approvedBy String?   @map("approved_by") @db.Uuid
  approvedAt DateTime? @map("approved_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  employee User  @relation("AttendanceExceptionEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  approver User? @relation("AttendanceExceptionApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([startDate, endDate])
  @@map("attendance_exceptions")
}

/// One row per employee per calendar day.
model AttendanceRecord {
  id             String    @id @default(uuid()) @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  attendanceDate DateTime  @map("attendance_date") @db.Date
  checkIn        DateTime? @map("check_in")
  checkOut       DateTime? @map("check_out")
  /// IANA timezone snapshot at check-in (employee or company default)
  employeeTimezone String? @map("employee_timezone") @db.VarChar(64)
  checkInUtc     DateTime? @map("check_in_utc")  @db.Timestamptz(6)
  checkOutUtc    DateTime? @map("check_out_utc") @db.Timestamptz(6)
  /// Local wall-clock display strings in employee timezone
  localCheckInTime  String? @map("local_check_in_time") @db.VarChar(40)
  localCheckOutTime String? @map("local_check_out_time") @db.VarChar(40)
  /// office | remote | hybrid
  workMode       String    @default("office") @map("work_mode") @db.VarChar(20)
  /// present | late | absent | on_leave | remote | hybrid
  status         String    @default("absent") @db.VarChar(20)
  totalHours     Decimal?  @map("total_hours") @db.Decimal(5, 2)
  lateMinutes    Int       @default(0) @map("late_minutes")
  remarks        String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  employee    User                   @relation("AttendanceRecordEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  auditLogs   AttendanceAuditLog[]
  corrections AttendanceCorrection[]

  @@unique([employeeId, attendanceDate])
  @@index([attendanceDate])
  @@index([status])
  @@map("attendance_records")
}

model AttendanceAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  recordId   String?  @map("record_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  action     String   @db.VarChar(40)
  // Nullable + SetNull so deleting the actor never destroys the audit trail
  // (the entry survives with actorId = null). Same posture as recordId.
  actorId    String?  @map("actor_id") @db.Uuid
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  record   AttendanceRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)
  employee User              @relation("AttendanceAuditEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  actor    User?             @relation("AttendanceAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([recordId])
  @@index([createdAt])
  @@map("attendance_audit_logs")
}

/// Recognition / award certificates issued by Admin/HR to an employee and
/// emailed to them as a generated PDF (download link). recipientName/email
/// are snapshotted so the record survives the recipient being changed.
model Certificate {
  id             String    @id @default(uuid()) @db.Uuid
  recipientId    String    @map("recipient_id") @db.Uuid
  recipientName  String    @map("recipient_name") @db.VarChar(200)
  recipientEmail String    @map("recipient_email") @db.VarChar(255)
  title          String    @db.VarChar(200)
  message        String?
  type           String    @default("achievement") @db.VarChar(40) // achievement | appreciation | recognition
  signatories    Json      @default("[]") // [{ name: string, title: string }]
  fileUrl        String?   @map("file_url")
  status         String    @default("draft") @db.VarChar(20) // draft | issued
  issuedById     String?   @map("issued_by_id") @db.Uuid
  issuedAt       DateTime? @map("issued_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at") // set when reverted; null = active (restorable)

  recipient User  @relation("CertificateRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  issuedBy  User? @relation("CertificateIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([recipientId])
  @@index([issuedById])
  @@index([status])
  @@index([deletedAt])
  @@map("certificates")
}
