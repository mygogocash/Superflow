  uploadedById  String?   @map("uploaded_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  employee   User  @relation("EmployeeAgreementOwner", fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("EmployeeAgreementUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([type])
