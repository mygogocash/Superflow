// ─── Survey Forms (Google-Forms-style) ───────────────────
//
// Lightweight, in-platform survey builder that runs alongside the
// xlsx-import wave system above. HR composes a form with mixed
// question types, targets a slice of the workforce, publishes it,
// and we collect responses + render analytics. Models are
// intentionally separate from `SurveyDefinition` / `SurveyWave` —
// those carry pulse-survey conventions (sections schema, demographic
// columns) that aren't a fit for ad-hoc form responses.

model SurveyForm {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(200)
  description String?
  status      String   @default("draft") @db.VarChar(20) // draft | published | closed
  isAnonymous Boolean  @default(false) @map("is_anonymous")
  // Targeting. When `targetAll` is true the targeting arrays are
  // ignored and every active employee can respond. Otherwise the
  // visible audience is the union of the three lists.
  targetAll          Boolean @default(true) @map("target_all")
  targetEntityIds    Json    @default("[]") @map("target_entity_ids")
  targetDepartments  Json    @default("[]") @map("target_departments")
  targetUserIds      Json    @default("[]") @map("target_user_ids")
  publishedAt DateTime? @map("published_at")
  closedAt    DateTime? @map("closed_at")
  // Optional open/close window. A published form is only "available" to
  // respondents between startDate and endDate (inclusive); HR can extend
  // endDate after publishing. Null = no bound on that side.
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  // Orthogonal to status — archiving hides a form from the active lists
  // (and the notification bell) without changing its lifecycle state.
  archivedAt  DateTime? @map("archived_at")
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  createdBy User                  @relation("SurveyFormCreator", fields: [createdById], references: [id])
  questions SurveyFormQuestion[]
  responses SurveyFormResponse[]

  @@index([status])
  @@index([createdById])
  @@index([archivedAt])
  @@index([endDate])
  @@map("survey_forms")
}

model SurveyFormQuestion {
  id           String  @id @default(uuid()) @db.Uuid
  surveyFormId String  @map("survey_form_id") @db.Uuid
  order        Int
  // type: short_text | long_text | single_choice | multi_choice
  //       | rating | date | number
  type         String  @db.VarChar(30)
  prompt       String
  helperText   String? @map("helper_text")
  required     Boolean @default(false)
  // For choice questions: array of strings, displayed in order.
  options      Json    @default("[]")
  // Free-form per-type knobs (e.g. {"min": 1, "max": 5} for rating).
  settings     Json    @default("{}")

  surveyForm SurveyForm           @relation(fields: [surveyFormId], references: [id], onDelete: Cascade)
  answers    SurveyFormAnswer[]

  @@index([surveyFormId, order])
  @@map("survey_form_questions")
}

model SurveyFormResponse {
  id           String   @id @default(uuid()) @db.Uuid
  surveyFormId String   @map("survey_form_id") @db.Uuid
  // Null when the survey is anonymous. Multiple anonymous responses
  // from the same user are allowed; non-anonymous surveys enforce
  // one-response-per-user via `@@unique` below.
  respondentId String?  @map("respondent_id") @db.Uuid
  submittedAt  DateTime @default(now()) @map("submitted_at")

  surveyForm SurveyForm           @relation(fields: [surveyFormId], references: [id], onDelete: Cascade)
  respondent User?                @relation("SurveyFormRespondent", fields: [respondentId], references: [id], onDelete: SetNull)
  answers    SurveyFormAnswer[]

  @@unique([surveyFormId, respondentId])
  @@index([surveyFormId])
  @@map("survey_form_responses")
}

model SurveyFormAnswer {
  id         String @id @default(uuid()) @db.Uuid
  responseId String @map("response_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  // Polymorphic value:
  //   - text/textarea → string
  //   - single_choice → string
  //   - multi_choice  → string[]
  //   - rating/number → number
  //   - date          → "YYYY-MM-DD" string
  value      Json

  response SurveyFormResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyFormQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
  @@index([questionId])
  @@map("survey_form_answers")
}

// ─── Survey (standalone form builder) ────────────────────
//
// Full clone of the Survey Forms engine above, exposed as the
// top-level "Survey" module (/survey). Independent tables so surveys
// and awards never share data. Replaces the retired xlsx-import wave
// system (SurveyDefinition/SurveyWave/SurveyResponse/UploadJob).

model Survey {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(200)
  description String?
  status      String   @default("draft") @db.VarChar(20) // draft | published | closed
  isAnonymous Boolean  @default(false) @map("is_anonymous")
  targetAll         Boolean @default(true) @map("target_all")
  targetEntityIds   Json    @default("[]") @map("target_entity_ids")
  targetDepartments Json    @default("[]") @map("target_departments")
  targetUserIds     Json    @default("[]") @map("target_user_ids")
  publishedAt DateTime? @map("published_at")
  closedAt    DateTime? @map("closed_at")
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  archivedAt  DateTime? @map("archived_at")
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  createdBy User             @relation("SurveyCreator", fields: [createdById], references: [id])
  questions SurveyQuestion[]
  responses SurveyResponse[]

  @@index([status])
  @@index([createdById])
  @@index([archivedAt])
  @@index([endDate])
  @@map("surveys")
}

model SurveyQuestion {
  id         String  @id @default(uuid()) @db.Uuid
  surveyId   String  @map("survey_id") @db.Uuid
  order      Int
  type       String  @db.VarChar(30)
  prompt     String
  helperText String? @map("helper_text")
  required   Boolean @default(false)
  options    Json    @default("[]")
  settings   Json    @default("{}")

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]

  @@index([surveyId, order])
  @@map("survey_questions")
}

model SurveyResponse {
  id           String   @id @default(uuid()) @db.Uuid
  surveyId     String   @map("survey_id") @db.Uuid
  respondentId String?  @map("respondent_id") @db.Uuid
  submittedAt  DateTime @default(now()) @map("submitted_at")

  survey     Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  respondent User?          @relation("SurveyRespondent", fields: [respondentId], references: [id], onDelete: SetNull)
  answers    SurveyAnswer[]

  @@unique([surveyId, respondentId])
  @@index([surveyId])
  @@map("survey_responses")
}

model SurveyAnswer {
  id         String @id @default(uuid()) @db.Uuid
  responseId String @map("response_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  value      Json

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
  @@index([questionId])
  @@map("survey_answers")
}

// ─── Travel Management ──────────────────────────────────

model TravelRequest {
  id                  String    @id @default(uuid()) @db.Uuid
  requestCode         String    @unique @map("request_code") @db.VarChar(20)
  employeeId          String    @map("employee_id") @db.Uuid
  entityId            String?   @map("entity_id")
  origin              String?
  destination         String
  purpose             String
  departureDate       DateTime  @map("departure_date") @db.Date
  returnDate          DateTime  @map("return_date") @db.Date
  estimatedBudget     Decimal?  @map("estimated_budget") @db.Decimal(15, 2)
  cashAdvance         Decimal?  @map("cash_advance") @db.Decimal(15, 2)
  currency            String    @default("USD")
  // Categorises the trip for amount-band approval routing. Drives which
  // `TravelApprovalStep` rows match via `categoryFilter`. Free string
  // so HR can extend without a migration; default `general` keeps
  // pre-feature requests on the universal chain.
  category            String    @default("general")
  // Flight booking preferences captured at submission time. Surfaced on
  // the request detail sheet so the travel desk has the full brief
  // without chasing the applicant (Tanny, HR feedback May 2026).
  //
  //   flightType:               one_way | round_trip | multi_trip
  //   seatingPreference:        window | aisle | other
  //   hotelLocationPreference:  near_meeting | near_airport
  //
  // All values are stored as free strings rather than enums so the
  // travel desk can extend the menus without a migration; the UI is
  // the source of truth for the canonical labels.
  flightType                String?   @map("flight_type")
  departureTimePreference   String?   @map("departure_time_preference")
  returnTimePreference      String?   @map("return_time_preference")
  mealPreference            String?   @map("meal_preference")
  seatingPreference         String?   @map("seating_preference")
  seatingPreferenceOther    String?   @map("seating_preference_other")
  dummyTicketRequired       Boolean   @default(false) @map("dummy_ticket_required")
  visaRequired              Boolean   @default(false) @map("visa_required")
  hotelRequired       Boolean   @default(false) @map("hotel_required")
  hotelLocationPreference String?   @map("hotel_location_preference")
  preferredHotel      String?   @map("preferred_hotel")
  hotelDetails        String?   @map("hotel_details")
  notes               String?
  attachments         Json      @default("[]")
  delegatedToId       String?   @map("delegated_to") @db.Uuid
  status              String    @default("draft")
  currentStepOrder    Int?      @map("current_step_order")
  approvedBy          String?   @map("approved_by") @db.Uuid
  approvedAt          DateTime? @map("approved_at")
  rejectReason        String?   @map("reject_reason")
  submittedAt         DateTime? @map("submitted_at")
  deletedAt           DateTime? @map("deleted_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  employee User     @relation("TravelRequestEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  approver User?    @relation("TravelRequestApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  delegate User?    @relation("TravelRequestDelegate", fields: [delegatedToId], references: [id], onDelete: SetNull)
  entity   Entity?  @relation(fields: [entityId], references: [id])
  expenses Expense[] @relation("ExpenseTravel")
  approvalDecisions TravelApprovalDecision[]

  @@index([employeeId])
  @@index([status])
  @@index([departureDate])
  @@index([deletedAt])
  @@map("travel_requests")
}

// Org-wide travel approval chain (admin-managed). Each row is one stage.
// Stages execute in ascending `order`; on submission they are snapshotted
// into `TravelApprovalDecision` rows so editing the chain later does not
// retroactively change in-flight requests.
model TravelApprovalStep {
  id              String   @id @default(uuid()) @db.Uuid
  order           Int      @unique
  name            String   @db.VarChar(100)
  description     String?
  approverType    String   @default("manager") @map("approver_type") // manager | user
  approverUserId  String?  @map("approver_user_id") @db.Uuid
  // Submitter-conditional routing. Stored as JSON arrays of User ids
  // so the chain admin can carve out exceptions without an extra
  // table:
  //   - `skipWhenSubmitterIds` — submitter ids for whom this step is
  //     skipped entirely (e.g. "Sid approval" should not require Sid
  //     to approve their own travel request).
  //   - `onlyWhenSubmitterIds` — when non-empty, the step only fires
  //     for these submitters (e.g. "CEO approval" only routes when Sid
  //     submits, since everyone else is handled by the prior step).
  // Both arrays are optional and default to empty.
  skipWhenSubmitterIds Json @default("[]") @map("skip_when_submitter_ids")
  onlyWhenSubmitterIds Json @default("[]") @map("only_when_submitter_ids")
  // Amount-band + category routing (May 2026 — Sarah/Sid feedback):
  //   - `categoryFilter` JSON String[] — apply only to these
  //     TravelRequest.category values (empty = match all).
  //   - `amountMinBaht` / `amountMaxBaht` — apply only when the
  //     request's cashAdvance, converted to THB via the latest
  //     ExchangeRate, falls inside [min, max]. Either bound can be
  //     null (open-ended). If FX conversion fails, the step is
  //     treated as not matching so the request still routes through
  //     unconditional steps.
  categoryFilter Json     @default("[]") @map("category_filter")
  amountMinBaht  Decimal? @map("amount_min_baht") @db.Decimal(15, 2)
  amountMaxBaht  Decimal? @map("amount_max_baht") @db.Decimal(15, 2)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  approverUser User? @relation("TravelApprovalStepUser", fields: [approverUserId], references: [id], onDelete: SetNull)

  @@map("travel_approval_steps")
}

// Per-request snapshot of the chain. `decidedById` is the user who acted
// on this stage (may differ from `approverUserId` once role-based stages
// land). Pending = waiting for that stage; skipped = stage condition not
// met when the request was submitted (kept for an audit trail).
model TravelApprovalDecision {
  id              String    @id @default(uuid()) @db.Uuid
  travelRequestId String    @map("travel_request_id") @db.Uuid
  order           Int
  name            String    @db.VarChar(100)
  approverType    String    @map("approver_type")
  approverUserId  String?   @map("approver_user_id") @db.Uuid
  status          String    @default("pending")
  decidedById     String?   @map("decided_by_id") @db.Uuid
  decidedAt       DateTime? @map("decided_at")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")

  travelRequest TravelRequest @relation(fields: [travelRequestId], references: [id], onDelete: Cascade)
  approverUser  User?         @relation("TravelApprovalDecisionApprover", fields: [approverUserId], references: [id], onDelete: SetNull)
  decidedBy     User?         @relation("TravelApprovalDecisionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([travelRequestId, order])
  @@index([approverUserId, status])
  @@index([travelRequestId])
  @@map("travel_approval_decisions")
}

// ─── Leave Management ───────────────────────────────────

model LeaveType {
  id               String  @id @default(cuid())
  // entityId nullable so a row with entityId=null is a "global" policy
  // visible to every employee. Entity-scoped rows only apply to staff
  // of that entity.
  entityId         String? @map("entity_id")
  name             String  @db.VarChar(100)
  code             String  @db.VarChar(20)
  description      String?
  category         String  @default("other") // sick | casual | earned | unpaid | other
  daysPerYear      Int     @default(0) @map("days_per_year")
  requiresApproval Boolean @default(true) @map("requires_approval")
  isPaid           Boolean @default(true) @map("is_paid")
  isActive         Boolean @default(true) @map("is_active")

  entity        Entity? @relation(fields: [entityId], references: [id], onDelete: Restrict)
  balances      LeaveBalance[]
  requests      LeaveRequest[]
  transactions  BalanceTransaction[]
  approvers     LeavePolicyApprover[]

  @@unique([entityId, code])
  @@unique([entityId, name])
  @@index([entityId, isActive])
  @@map("leave_types")
}

// Per-policy ordered approver chain. Mirrors TravelApprovalStep but
// scoped to a single leave type. When a leave request is submitted,
// the approver(s) for that policy decide it. Manager type resolves to
// the submitter's reportingTo at request time.
model LeavePolicyApprover {
  id             String   @id @default(uuid()) @db.Uuid
  leaveTypeId    String   @map("leave_type_id")
  order          Int
  approverType   String   @default("manager") @map("approver_type") // manager | user
  approverUserId String?  @map("approver_user_id") @db.Uuid
  // Per-step conditions (parity with LeaveApprovalStep). Submitter gating
  // by user id, plus a whole-day band on the request's `days` (min/max
  // inclusive, null = unbounded). Evaluated at snapshot time.
  skipWhenSubmitterIds Json    @default("[]") @map("skip_when_submitter_ids")
  onlyWhenSubmitterIds Json    @default("[]") @map("only_when_submitter_ids")
  minDays              Int?    @map("min_days")
  maxDays              Int?    @map("max_days")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  leaveType    LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  approverUser User?     @relation("LeavePolicyApproverUser", fields: [approverUserId], references: [id], onDelete: SetNull)

  @@unique([leaveTypeId, order])
  @@index([leaveTypeId])
  @@index([approverUserId])
  @@map("leave_policy_approvers")
}

model LeaveBalance {
  id          String  @id @default(uuid()) @db.Uuid
  employeeId  String  @map("employee_id") @db.Uuid
  leaveTypeId String  @map("leave_type_id")
  year        Int
  entitled    Decimal @default(0) @db.Decimal(4, 1)
  /// Days consumed from the entitlement bucket. Historical balances
  /// (pre carried-bucket split) folded carried-over days into this
  /// column; new approvals route to `carriedUsed` when the request is
  /// flagged `source = "carried"`.
  used        Decimal @default(0) @db.Decimal(4, 1)
  carried     Decimal @default(0) @db.Decimal(4, 1)
  /// Days consumed from the carried-over bucket. Stays in lockstep
  /// with `used`: an approved request decrements one of the two based
  /// on `LeaveRequest.source`.
  carriedUsed   Decimal   @default(0) @map("carried_used") @db.Decimal(4, 1)
  /// HR-set deadline for using the carried bucket — e.g. 2025 carry-
  /// over expires 31-Mar-2026. After this date the carried bucket
  /// stops being a valid `source` for new leave requests.
  carriedExpiry DateTime? @map("carried_expiry") @db.Date
  adjustment    Decimal   @default(0) @db.Decimal(4, 1)

  employee  User      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model BalanceTransaction {
  id          String   @id @default(uuid()) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  leaveTypeId String   @map("leave_type_id")
  year        Int
  type        String   @db.VarChar(30)
  /// Signed delta applied to the balance by this event, in days.
  /// Decimal(6,1) so half-day leave (0.5) and half-day HR edits are
  /// recorded exactly — an Int column silently rounded them and made
  /// the ledger disagree with `leave_balances.used`.
  /// For `used` / `cancellation_refund` rows this is the request's
  /// days; for `manual_adjustment` / `bulk_import` rows it is the
  /// change to `used` (the description carries every other field).
  amount      Decimal  @db.Decimal(6, 1)
  description String?
  referenceId String?  @map("reference_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  employee  User      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([employeeId, leaveTypeId, year])
  @@map("balance_transactions")
}

model LeaveRequest {
  id              String    @id @default(uuid()) @db.Uuid
  employeeId      String    @map("employee_id") @db.Uuid
  leaveTypeId     String    @map("leave_type_id")
  entityId        String?   @map("entity_id")
  startDate       DateTime  @map("start_date") @db.Date
  endDate         DateTime  @map("end_date") @db.Date
  /// `full_day` (default) or `half_day` — half-day requests always use 0.5 days.
  durationType    String    @default("full_day") @map("duration_type")
  /// When `durationType = half_day`: `am` or `pm`.
  halfDayPeriod   String?   @map("half_day_period")
  days            Decimal   @db.Decimal(4, 1)
  /// Which bucket the days come out of when the request is approved:
  /// `entitled` (default) decrements `LeaveBalance.used`; `carried`
  /// decrements `LeaveBalance.carriedUsed` and requires the balance's
  /// `carriedExpiry` to be in the future.
  source          String    @default("entitled")
  reason          String?
  status          String    @default("pending")
  // Tracks which approval-chain step is currently waiting for action
  // while the request sits in `status = "pending"`. Null on creation
  // for legacy rows; lazy-snapshotted on first approve/reject if so.
  currentStepOrder Int?     @map("current_step_order")
  /// True while this request's days are currently drawn down from
  /// `LeaveBalance.used` / `carriedUsed`. Set on final approval, cleared
  /// on any refund (self-cancel, cancellation approval, delete). Makes
  /// every balance mutation idempotent: a refund can never fire twice
  /// and a restore can never double-charge.
  balanceDeducted Boolean  @default(false) @map("balance_deducted")
  approvedBy      String?   @map("approved_by") @db.Uuid
  approvedAt      DateTime? @map("approved_at")
  rejectReason    String?   @map("reject_reason")
  delegatedToId   String?   @map("delegated_to") @db.Uuid
  reminderCount   Int       @default(0) @map("reminder_count")
  lastReminderAt  DateTime? @map("last_reminder_at")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  employee  User      @relation("LeaveRequestEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
  approver  User?     @relation("LeaveRequestApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  delegate  User?     @relation("LeaveRequestDelegate", fields: [delegatedToId], references: [id], onDelete: SetNull)
  entity    Entity?   @relation(fields: [entityId], references: [id])
  approvalDecisions LeaveApprovalDecision[]

  @@index([employeeId])
  @@index([status])
  @@index([delegatedToId])
  @@index([deletedAt])
  @@map("leave_requests")
}

// Org-wide leave approval chain (admin-managed). Mirrors the travel and
// expense chains — each row is one ordered stage, snapshotted to
// `LeaveApprovalDecision` rows on submit so chain edits never rewrite
// in-flight requests.
model LeaveApprovalStep {
  id                   String   @id @default(uuid()) @db.Uuid
  order                Int      @unique
  name                 String   @db.VarChar(100)
  description          String?
  approverType         String   @default("manager") @map("approver_type") // manager | user
  approverUserId       String?  @map("approver_user_id") @db.Uuid
  skipWhenSubmitterIds Json     @default("[]") @map("skip_when_submitter_ids")
  onlyWhenSubmitterIds Json     @default("[]") @map("only_when_submitter_ids")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  approverUser User? @relation("LeaveApprovalStepUser", fields: [approverUserId], references: [id], onDelete: SetNull)

  @@map("leave_approval_steps")
}

// Per-request snapshot of the chain. Mirrors travel/expense decisions.
model LeaveApprovalDecision {
  id              String    @id @default(uuid()) @db.Uuid
  leaveRequestId  String    @map("leave_request_id") @db.Uuid
  order           Int
  name            String    @db.VarChar(100)
  approverType    String    @map("approver_type")
  approverUserId  String?   @map("approver_user_id") @db.Uuid
  status          String    @default("pending")
  decidedById     String?   @map("decided_by_id") @db.Uuid
  decidedAt       DateTime? @map("decided_at")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  approverUser User?        @relation("LeaveApprovalDecisionApprover", fields: [approverUserId], references: [id], onDelete: SetNull)
  decidedBy    User?        @relation("LeaveApprovalDecisionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([leaveRequestId, order])
  @@index([approverUserId, status])
  @@index([leaveRequestId])
  @@map("leave_approval_decisions")
}

model PublicHoliday {
  id        String   @id @default(uuid()) @db.Uuid
  // Scoped to one entity (e.g. Manut India). Mirrors LeaveType.entityId so
  // the same Entity selector can drive both Leave Policies and Holidays.
  entityId  String   @map("entity_id")
  date      DateTime @db.Date
  name      String   @db.VarChar(120)
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, date])
  @@index([entityId, date])
  @@map("public_holidays")
}

model PayrollRun {
  id         String    @id @default(cuid())
  entityId   String    @map("entity_id")
  period     String
  status     String    @default("draft")
  /// Headline totals — entity-currency rows only. Mixed-currency
  /// payslips (USD/INR contractors paid through a THB entity) get
  /// summed separately in `currencyTotals` so adding them numerically
  /// doesn't pollute the run-level take-home figure.
  totalGross Decimal   @default(0) @map("total_gross") @db.Decimal(15, 2)
  totalNet   Decimal   @default(0) @map("total_net") @db.Decimal(15, 2)
  totalTax   Decimal   @default(0) @map("total_tax") @db.Decimal(15, 2)
  /// `{ [ISO ccy]: { gross, tax, net, count } }` — full per-currency
  /// breakdown of the run. Populated by the bulk import + payslip
  /// edit flows; older runs without an import re-commit keep this
  /// null (and the headline numbers retain their original mixed sum).
  currencyTotals Json?  @map("currency_totals")
  runBy      String    @map("run_by") @db.Uuid
  approvedBy String?   @map("approved_by") @db.Uuid
  approvedAt DateTime? @map("approved_at")
  paidAt     DateTime? @map("paid_at")
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  entity   Entity    @relation(fields: [entityId], references: [id])
  runner   User      @relation("PayrollRunner", fields: [runBy], references: [id], onDelete: Cascade)
  approver User?     @relation("PayrollApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  payslips Payslip[]

  @@unique([entityId, period])
  @@map("payroll_runs")
}

model Payslip {
  id           String  @id @default(uuid()) @db.Uuid
  payrollRunId String  @map("payroll_run_id")
  employeeId   String  @map("employee_id") @db.Uuid
  baseSalary   Decimal @map("base_salary") @db.Decimal(15, 2)
  allowances   Json?
  deductions   Json?
  grossPay     Decimal @map("gross_pay") @db.Decimal(15, 2)
  netPay       Decimal @map("net_pay") @db.Decimal(15, 2)
  currency     String
  /// HR-supplied gross / net expressed in the run's entity (base) currency.
  /// Populated by the bulk importer from the "Total Payout {entityCurrency}"
  /// column in HR's template — the spreadsheet already encodes the per-row
  /// FX equivalent so we don't need a separate ExchangeRate row to render
  /// a correct headline. Null for rows the importer couldn't infer a base
  /// value for (legacy rows, manual single-payslip writes, or non-base
  /// currency rows where HR left the base-currency column blank) — in that
  /// case the aggregator falls back to ExchangeRate-based FX as before.
  grossPayBase Decimal? @map("gross_pay_base") @db.Decimal(15, 2)
  netPayBase   Decimal? @map("net_pay_base") @db.Decimal(15, 2)
  /// Point-in-time snapshots of Position / Department / Start Date as
  /// they appeared on the HR spreadsheet at import time. Sourced from
  /// the xlsx — falls back to the User profile when the cell is blank.
  /// Stored on the payslip (not derived from the live `users` row) so
  /// a placeholder contractor or a later job-title change can't rewrite
  /// the historical payroll record.
  positionSnapshot   String?   @map("position_snapshot")
  departmentSnapshot String?   @map("department_snapshot")
  startDateSnapshot  String?   @map("start_date_snapshot")

  /// HR-uploaded payslip PDF (or other supported document) on the
  /// `documents` Supabase bucket. Nullable — a payslip row can exist
  /// without a PDF (numbers-only entry from the bulk importer). The
  /// employee-facing /my-portal "My Payslip" tab gates the download
  /// button on this field.
  documentUrl        String?   @map("document_url")

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   User       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Same person can hold one payslip per currency in the same run — HR
  // pays a few contractors a THB retainer + a USD performance fee in
  // the same period, and the xlsx legitimately lists them on two rows.
  // Previously this collided with a (run, employee) unique, forcing
  // the importer to merge the rows (and to silently mix currencies).
  @@unique([payrollRunId, employeeId, currency])
  @@map("payslips")
}

model ConsultantInvoice {
