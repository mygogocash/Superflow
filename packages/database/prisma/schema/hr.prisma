  whtAmount    Decimal  @default(0) @map("wht_amount") @db.Decimal(15, 2)
  netAmount    Decimal  @map("net_amount") @db.Decimal(15, 2)
  period       String
  status       String   @default("pending")
  certIssued   Boolean  @default(false) @map("cert_issued")
  createdAt    DateTime @default(now()) @map("created_at")

  entity     Entity @relation(fields: [entityId], references: [id])
  consultant User   @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  @@map("consultant_invoices")
}

// Captures the equity components from the Equity Summary Report:
//   - Tokens / Equity (contract): currency- or share-denominated.
//   - Sign-up Equity Bonus, CXO Equity, Golden Handcuff: usually shares.
//   - Annual review uplift: percent of base pay.
//   - Monthly allocations (sheet "Monthly Equity from Emp Contract"):
//     allocationMode = "monthly_recurring" with start/end months.
model EsopGrant {
  id              String   @id @default(uuid()) @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  grantDate       DateTime @map("grant_date") @db.Date
  grantType       String   @default("equity") @map("grant_type")
  valueType       String   @default("shares") @map("value_type")
  shares          Int      @default(0)
  currencyCode    String?  @map("currency_code")
  currencyAmount  Decimal? @map("currency_amount") @db.Decimal(15, 2)
  percentOfBase   Decimal? @map("percent_of_base") @db.Decimal(5, 2)
  // Lock / vesting / increasing periods are nullable so the imported
  // ESOP table can reflect HR's spreadsheet faithfully — empty xlsx
  // cells render as "—" instead of being silently rewritten with the
  // old PRD §11.4 defaults (lock 0 / vesting 48 / cliff 12). Manual
  // create / edit can still populate these; the importer keeps null
  // when the source cell is blank.
  vestingMonths   Int?     @map("vesting_months")
  cliffMonths     Int?     @map("cliff_months")
  lockMonths      Int?     @map("lock_months")
  strikePrice     Decimal  @default(0) @map("strike_price") @db.Decimal(10, 4)
  allocationMode       String    @default("one_time") @map("allocation_mode")
  monthlyAmount        Decimal?  @map("monthly_amount") @db.Decimal(15, 2)
  allocationStartMonth DateTime? @map("allocation_start_month") @db.Date
  allocationEndMonth   DateTime? @map("allocation_end_month") @db.Date
  source          String?
  status          String   @default("active")
  exercisedShares Int      @default(0) @map("exercised_shares")
  // Manual override for "Total Vesting to date" on a vesting grant.
  // NULL = auto-compute via vestedSharesToDate (linear by elapsed
  // months); a value pins the figure HR entered by hand when the sheet
  // shows a number the linear formula can't reproduce (e.g. a row
  // valued at a different date than the rest of the report).
  vestedToDateOverride Int? @map("vested_to_date_override")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  employee User @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("esop_grants")
}

// Captures HR's "Equity Monthly Salary" sheet — per-employee monthly
// equity allocations derived from converting a fixed monthly salary
// (e.g. THB 87,975) into USD via the Bank of Thailand reference rate
// on the salary payment date, then dividing by the strike price to
// get a share count. CXO-tier rows store fixed shares directly.
//
// Rows are name-keyed (not FK to User) because the imported sheet can
// list employees outside the platform's user table, and HR re-imports
// the whole sheet rather than editing rows individually.
model EquityMonthlySalary {
  id            String    @id @default(uuid()) @db.Uuid
  employeeName  String    @map("employee_name")
  position      String?
  startDate     DateTime? @map("start_date") @db.Date
  // THB / INR / USD — extracted from the employee's name suffix in
  // the imported sheet, drives which reference salary is converted
  // for the formula-based rows.
  currency      String?
  year          Int
  // Map of three-letter month abbrev -> share count for the year.
  // e.g. {"Feb": 121.28, "Mar": 114.74}. Decimal-valued; stored as
  // Json so missing months simply don't appear and we don't pay for
  // 12 nullable Decimal columns in postgres.
  monthlyShares Json      @default("{}") @map("monthly_shares")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([year])
  @@map("equity_monthly_salary")
}

// HR-managed agreement / compliance documents (working agreement, visa,
// passport, NDA, etc.). HR/admin uploads on behalf of an employee; the
// employee can view their own row through the same endpoint.
model EmployeeAgreement {
