  organizationMemberships OrganizationMembership[] @relation("OrgMembershipUser")
  organizationMembershipsInvited OrganizationMembership[] @relation("OrgMembershipInviter")
  manager       User?   @relation("UserManager", fields: [reportingTo], references: [id], onDelete: SetNull)
  directReports User[]  @relation("UserManager")

