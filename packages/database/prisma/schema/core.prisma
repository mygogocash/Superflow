model Entity {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  country       String
  currency      String
  accountingStd String   @default("IFRS") @map("accounting_std")
  taxId         String?  @map("tax_id")
  address       String?
  isActive      Boolean  @default(true) @map("is_active")

  // ── Accounting company setup (Phase-1 Foundation, Chunk 2) ────────────────
  // All additive / optional / defaulted so existing rows are unaffected.
  // `setupState` defaults to "active" so the ADD COLUMN backfills every
  // pre-existing entity to "active" — they keep issuing documents with no
  // interruption (grandfathered). Only entities created through the new
  // company-setup flow start life in "setup".
  nameTh                String?   @map("name_th")
  branchCode            String?   @map("branch_code") // head office = "00000"; nullable, no forced default on existing rows
  logoUrl               String?   @map("logo_url")
  vatRegistrationStatus String?   @map("vat_registration_status") // registered | not_registered | exempt
  boiType               String?   @map("boi_type") // optional BOI metadata (PRD decision #5, single set of books in v1)
  boiPeriod             String?   @map("boi_period")
  fiscalYearStartMonth  Int       @default(1) @map("fiscal_year_start_month") // 1–12; PRD decision #1 default = January, configurable
  firstFiscalYearStart  DateTime? @map("first_fiscal_year_start") // short/long first year
  firstFiscalYearEnd    DateTime? @map("first_fiscal_year_end")
  defaultRateSource     String    @default("bot") @map("default_rate_source") // bot | commercial_bank
  enabledCurrencies     String[]  @default([]) @map("enabled_currencies") // Postgres text[]; default empty
  setupState            String    @default("active") @map("setup_state") // active | setup — default "active" grandfathers existing rows

  // Multi-org tenancy: legal company belongs to one Organization tenant.
  // Nullable until backfill; required after org tenancy migration.
  organizationId String? @map("organization_id")

  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users              User[]
  userMemberships    UserEntityMembership[]
  chartOfAccounts    ChartOfAccount[]
  journalEntries     JournalEntry[]
  invoices           Invoice[]
  bankTransactions   BankTransaction[]
  payrollRuns        PayrollRun[]
  consultantInvoices ConsultantInvoice[]
  expenses         Expense[]       @relation("ExpenseEntity")
  expenseReports   ExpenseReport[] @relation("ExpenseReportEntity")
  cashAdvanceRequests CashAdvanceRequest[] @relation("CashAdvanceRequestEntity")
  visaRecords        VisaRecord[]
  ninetyDayNotifications NinetyDayNotification[]
  onboardingRuns         OnboardingRun[]
  offboardingRuns        OffboardingRun[]
  benefits               Benefit[]
  leaveTypes             LeaveType[]
  leaveRequests          LeaveRequest[]
  travelRequests         TravelRequest[]
  legalDocuments         LegalDocument[]
  legalAnnouncements     LegalAnnouncement[]
  publicHolidays         PublicHoliday[]
  companyPolicies        CompanyPolicy[]
  vendors                Vendor[]
  attendancePolicies     AttendancePolicy[]
  attendanceShifts       AttendanceShift[]
  bankAccounts           BankAccount[]
  payments               Payment[]
  quotes                 Quote[]
  purchaseOrders         PurchaseOrder[]
  creditNotes            CreditNote[]
  taxCodes               TaxCode[]
  accountMappings        AccountMapping[]
  documentSequences      DocumentSequence[]
  fiscalPeriods          FiscalPeriod[]

  @@index([organizationId])
  @@map("entities")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  name               String
  avatarUrl          String?   @map("avatar_url")
  /// LINE Messaging / Login subject (`userId` from LINE). Unique when set.
  lineUserId         String?   @unique @map("line_user_id")
  phone              String?
  phonePublic        Boolean   @default(false) @map("phone_public")
  entityId           String?   @map("entity_id")
  // Multi-company (Accounting Phase-1, PRD Rule 7). The company the user
  // currently has selected. ADDITIVE + nullable; plain String (no FK) so
  // an entity delete can't cascade into users — membership is validated
  // in the service. `entityId` above stays the user's home entity.
  activeEntityId     String?   @map("active_entity_id")
  // Multi-org: selected Organization (session). Validated against membership.
  activeOrganizationId String? @map("active_organization_id")
  // Manut platform role: platform_admin | platform_operator | null.
  // Cross-org power — never grant via org Super Admin.
  platformRole       String?   @map("platform_role")
  department         String?
  jobTitle           String?   @map("job_title")
  employeeId         String?   @unique @map("employee_id")
  reportingTo        String?   @map("reporting_to") @db.Uuid
  employmentType     String    @default("full_time") @map("employment_type")
  startDate          DateTime? @map("start_date")
  endDate            DateTime? @map("end_date")
  salary             Decimal?  @db.Decimal(15, 2)
  currency           String?
  location           String?
  country            String?
  timezone           String?
  // Preferred UI language (BCP-47 primary subtag, e.g. "en" / "th"). Resolved
  // as user.locale -> app.locale (org default) -> browser. Null = follow the
  // org/browser default.
  locale             String?
  dateOfBirth        DateTime? @map("date_of_birth") @db.Date
  passportNumber     String?   @map("passport_number")
  nationality        String?
  thaiId             String?   @map("thai_id")
  taxId              String?   @map("tax_id")
  aadhaarNumber      String?   @map("aadhaar_number")
  panCardNumber      String?   @map("pan_card_number")
  workPermitType     String?   @map("work_permit_type")
  visaType           String?   @map("visa_type")
  permitNumber       String?   @map("permit_number")
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  metadata           Json?
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  entity        Entity? @relation(fields: [entityId], references: [id], onDelete: SetNull)
