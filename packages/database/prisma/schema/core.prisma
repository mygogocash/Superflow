/// Inbound/outbound LINE Messaging API audit (PII-light preview + optional raw).
model LineMessageLog {
  id          String   @id @default(cuid())
  lineUserId  String   @map("line_user_id")
  userId      String?  @map("user_id") @db.Uuid
  eventType   String   @map("event_type")
  direction   String   @default("inbound")
  messageType String?  @map("message_type")
  preview     String?
  raw         Json?
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([lineUserId])
  @@index([userId])
  @@index([createdAt])
  @@map("line_message_logs")
}

// Multi-company foundation (Accounting Phase-1, PRD Rule 7). Which
// entities a user belongs to, plus an optional per-company role. This
// table is ADDITIVE and DOES NOT participate in permission resolution —
// `resolvePermissions` is unchanged. `roleId` is stored now and ENFORCED
// in a later chunk (per-entity RBAC). The company switcher reads these
// rows; switching writes `User.activeEntityId` after validating a matching
// active membership exists.
model UserEntityMembership {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Uuid
  entityId  String   @map("entity_id")
  roleId    String?  @map("role_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([userId, entityId])
  @@index([entityId])
  @@map("user_entity_memberships")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

// Pre-auth attempt log — covers password reset + magic link requests
// where the actor is anonymous (only an email + IP). Powers two
// downstream features:
// 1. Sliding-window rate limiter (3 per email/hour, 10 per IP/hour)
//    via `SELECT count(*) WHERE email=? AND action IN (...) AND
//    created_at > now() - '1 hour'`.
// 2. Post-incident SOC audit — answer "who attempted recovery for
//    this account from which IP" after a suspected compromise.
//
// `userId` is best-effort: forgot/magic flows look the email up and
// store the match when present, but a 200 response is returned to the
// caller either way (no enumeration). When the user is deleted we
// keep the row for forensics, just null the link.
model AuthLog {
  id           String   @id @default(uuid()) @db.Uuid
  // Always store lowercased — the auth service normalises before
  // insert so the rate-limit query can use exact equality.
  email        String   @db.VarChar(254)
  // `x-forwarded-for` head or socket peer. Nullable because the
  // Express request may surface neither in unusual proxy configs.
  ip           String?  @db.VarChar(64)
  // "forgot-password" | "magic-link" | "recover-password" | "exchange-session"
  action       String   @db.VarChar(32)
  success      Boolean
  // Short machine-readable reason for failures
  // ("user-not-found" | "rate-limited" | "supabase-error" | etc.).
  // Long enough to capture a redacted Supabase error message tail.
  errorMessage String?  @map("error_message") @db.VarChar(500)
  userId       String?  @map("user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation("AuthLogTarget", fields: [userId], references: [id], onDelete: SetNull)

  // Composite index for the rate-limit query (email + action +
  // recency). Ordered (email, action, createdAt) so the planner can
  // use it for either equality+range or pure equality lookups.
  @@index([email, action, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
  @@map("auth_logs")
}

model Department {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  code        String?  @unique @db.VarChar(20)
  description String?
  headId      String?  @map("head_id") @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   Department?  @relation("DepartmentParent", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentParent")

  @@index([parentId])
  @@index([isActive])
  @@map("departments")
}
