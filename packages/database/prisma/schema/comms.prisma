model Conversation {
  id            String    @id @default(uuid()) @db.Uuid
  type          String    @default("direct") @db.VarChar(20)
  directKey     String?   @unique @map("direct_key")
  title         String?
  createdBy     String    @map("created_by") @db.Uuid
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  creator  User                 @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  members  ConversationMember[]
  messages Message[]

  @@index([createdBy])
  @@index([type])
  @@index([updatedAt(sort: Desc)])
  @@map("conversations")
}

model ConversationMember {
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  role           String    @default("member") @db.VarChar(20)
  joinedAt       DateTime  @default(now()) @map("joined_at")
  leftAt         DateTime? @map("left_at")
  lastReadAt     DateTime? @map("last_read_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, leftAt])
  @@map("conversation_members")
}

model Message {
  id                  String    @id @default(uuid()) @db.Uuid
  conversationId      String    @map("conversation_id") @db.Uuid
  authorId            String    @map("author_id") @db.Uuid
  content             String?
  kind                String    @default("text") @db.VarChar(20)
  deletedForEveryoneAt DateTime? @map("deleted_for_everyone_at")
  deletedBy           String?   @map("deleted_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  conversation Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  deleter      User?            @relation("MessageDeleter", fields: [deletedBy], references: [id])
  hiddenFor    MessageHiddenFor[]
  reactions    MessageReaction[]

  @@index([authorId])
  @@index([conversationId])
  @@index([conversationId, createdAt(sort: Desc)])
  @@map("messages")
}

model MessageHiddenFor {
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  hiddenAt  DateTime @default(now()) @map("hidden_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
  @@map("message_hidden_for")
}

model MessageReaction {
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  emoji     String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
  @@map("message_reactions")
}

model WallPost {
  id        String   @id @default(uuid()) @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  content   String
  type      String   @default("post")
  likes     Json?
  reactions Json?
  /// Array of `{ name, url, mimeType, size }` for files (images / PDFs)
  /// uploaded via the shared `uploads` Supabase bucket. Same shape as
  /// `HelpdeskTicket.attachments` so the home-page UI can render chips
  /// without inventing a new join table.
  attachments Json?
  /// Optional in-app deep link (e.g. an auto-posted survey announcement
  /// points at "/survey-forms/:id/respond"). Null for ordinary posts.
  linkUrl   String?  @map("link_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments WallComment[]

  @@index([createdAt(sort: Desc)])
  @@map("wall_posts")
}

model WallComment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  content   String
  type      String   @default("comment")
  createdAt DateTime @default(now()) @map("created_at")

  post   WallPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("wall_comments")
}

model CompanyNews {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  content   String
  category  String?
  authorId  String   @map("author_id") @db.Uuid
  isPinned  Boolean  @default(false) @map("is_pinned")
  /// Array of `{ name, url, mimeType, size }` for files (images / PDFs)
  /// uploaded via the shared `uploads` Supabase bucket.
  attachments Json?
  /// Optional in-app deep link (survey announcements point at the respond
  /// page). Null for ordinary news.
  linkUrl   String?  @map("link_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@map("company_news")
}

model CompanyDate {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  date      DateTime @db.Date
  type      String
  location  String?
  /// Array of `{ name, url, mimeType, size }` for supporting files
  /// (invitation PDFs, hero images) uploaded via the shared `uploads`
  /// Supabase bucket.
  attachments Json?
  /// Optional in-app deep link (survey "closes" reminders point at the
  /// respond page). Null for ordinary dates.
  linkUrl   String?  @map("link_url")
  addedBy   String   @map("added_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  adder User @relation(fields: [addedBy], references: [id], onDelete: Cascade)

  @@index([date])
  @@map("company_dates")
}

model AriaConversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   AriaMessage[]
  queryLogs  AriaQueryLog[]
  traces     AriaInteractionTrace[]
  summary    AriaConversationSummary?
  memory     AriaConversationMemory[]

  @@index([userId])
  @@map("aria_conversations")
}

// Compacted "earlier in this conversation" summary for chats that have
// outgrown the 40-message verbatim window. Stored 1:1 with the
// conversation; regenerated whenever the verbatim window slides past
// `coversThroughMessageId`. Kept lightweight (single TEXT column) so a
// summary write never blocks the user-facing stream — the call to the
// summariser is fired-and-forgotten after the assistant reply.
model AriaConversationSummary {
  conversationId          String   @id @map("conversation_id") @db.Uuid
  summary                 String
  // Last message id incorporated into the summary. The next time the
  // verbatim window slides past this id we regenerate.
  coversThroughMessageId  String?  @map("covers_through_message_id") @db.Uuid
  messageCount            Int      @default(0) @map("message_count")
  model                   String
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  conversation AriaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("aria_conversation_summaries")
}

// Pinned key/value facts extracted from a conversation. Injected into
// the system prompt every turn so ARIA "remembers" persistent details
// (e.g. "user is reviewing Q2 expenses for Manut-TH"). Background
// extractor runs after each assistant reply.
model AriaConversationMemory {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  key            String
  value          String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  conversation AriaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, key])
  @@index([conversationId])
  @@map("aria_conversation_memory")
}

model AriaMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           String
  content        String
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AriaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedback     AriaFeedback[]
  attachments  AriaAttachment[]
  traces       AriaInteractionTrace[]

  @@index([conversationId])
  @@map("aria_messages")
}

/// A file a user attached to an ARIA chat message (image / document / video).
/// Uploaded first (upload-first flow) — `messageId` is null until the message
/// that references it is sent. Bytes live in a private Supabase bucket; the
/// chat turn rebuilds the Claude content block from `storagePath` (image/pdf)
/// or from `extractedText` (text docs + video transcript). `status` is `ready`
/// except while a video is being transcribed (`processing`).
model AriaAttachment {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  messageId      String?   @map("message_id") @db.Uuid
  /// 'image' | 'document' | 'video'
  kind           String
  name           String
  mimeType       String    @map("mime_type")
  size           Int
  storageBucket  String    @map("storage_bucket")
  storagePath    String    @map("storage_path")
  /// Extracted text (txt/csv/md/office) or video transcript; null for image/pdf.
  extractedText  String?   @map("extracted_text")
  /// 'ready' | 'processing' | 'failed'
  status         String    @default("ready")
  createdAt      DateTime  @default(now()) @map("created_at")

  user    User         @relation("AriaAttachmentUploader", fields: [userId], references: [id], onDelete: Cascade)
  message AriaMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([messageId])
  @@map("aria_attachments")
}

// Phase 6 — self-improvement loop.
//
// Per-user thumbs rating on a specific assistant message, with
// optional free-text reason on thumbs-down. The unique on
// (messageId, userId) lets a user revise their rating but keeps one
// row per pair so we don't double-count in the improvement queue.
//
// `reviewed` flips when an admin clears the row from the queue
// (either by drafting a knowledge article or marking it dismissed).
// `resultingArticleId` closes the loop — if the feedback drove a new
// article, we can later report on how often that article was
// retrieved + how it changed downstream ratings.
model AriaFeedback {
  id                 String   @id @default(uuid()) @db.Uuid
  messageId          String   @map("message_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  rating             String   // "up" | "down"
  reason             String?  @db.VarChar(1000)
  reviewed           Boolean  @default(false)
  reviewedById       String?  @map("reviewed_by_id") @db.Uuid
  reviewedAt         DateTime? @map("reviewed_at")
  reviewNote         String?  @map("review_note") @db.VarChar(500)
  resultingArticleId String?  @map("resulting_article_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  message          AriaMessage           @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user             User                  @relation("AriaFeedbackAuthor", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy       User?                 @relation("AriaFeedbackReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  resultingArticle AriaKnowledgeArticle? @relation(fields: [resultingArticleId], references: [id], onDelete: SetNull)

  @@unique([messageId, userId])
  @@index([rating, reviewed, createdAt])
  @@index([reviewedById])
  @@map("aria_feedback")
}

// Curated knowledge corpus surfaced into the ARIA system prompt at
// chat time. v1 uses keyword matching against the user's message;
// a future iteration can swap in vector embeddings without changing
// the public shape.
model AriaKnowledgeArticle {
  id          String   @id @default(uuid()) @db.Uuid
  // 'immigration' | 'hr' | 'finance' | 'policy' | 'other'
  category    String
  title       String
  slug        String   @unique
  body        String
  keywords    String[]
  tags        String[]
  // Permission gate for retrieval. Empty list = article is public for
  // any signed-in user. Non-empty list = user must hold AT LEAST ONE
  // of these permission codes for ARIA to surface the article in
  // chat. Matches the OR shape of the existing `canSee*` helpers in
  // `aria-context.ts` so reviewers don't need to learn a new pattern.
  // Stored as plain strings (no FK to permissions catalog) so HR can
  // reference future perms without a join.
  requiredPermissions String[] @default([]) @map("required_permissions")
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy        User?          @relation("AriaKnowledgeArticleAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  sourceFeedback   AriaFeedback[]

  @@index([category, isActive])
  @@index([slug])
  @@map("aria_knowledge_articles")
}

// Per-turn telemetry written by `aria.service.chatStream`. Powers the
// admin insights page (hit-rate, latency, token spend, empty-retrieval
// queries to curate). Best-effort writes — failures are swallowed so
// telemetry never breaks chat. Retention policy applied via cron
// (PII-bearing `userMessage` is purged after 30 days).
model AriaQueryLog {
  id                  String   @id @default(uuid()) @db.Uuid
  conversationId      String?  @map("conversation_id") @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  userMessage         String   @map("user_message")
  retrievedArticleIds String[] @default([]) @map("retrieved_article_ids") @db.Uuid
  // Cosine distances aligned 1:1 with `retrievedArticleIds`. Stored as
  // Float[] so we can compute p50/p95 over a window without re-running
  // retrieval.
  retrievedDistances  Float[]  @default([]) @map("retrieved_distances")
  // Lowest distance seen across the full candidate set (incl. rows
  // filtered out by the threshold). Lets us tune the threshold from
  // real traffic.
  topDistance         Float?   @map("top_distance")
  retrievalMode       String   @default("vector") @map("retrieval_mode")
  workspaceBytes      Int      @default(0) @map("workspace_bytes")
  knowledgeBytes      Int      @default(0) @map("knowledge_bytes")
  latencyMs           Int      @map("latency_ms")
  tokensIn            Int?     @map("tokens_in")
  tokensOut           Int?     @map("tokens_out")
  cacheReadTokens     Int?     @map("cache_read_tokens")
  cacheCreateTokens   Int?     @map("cache_create_tokens")
  model               String
  error               Boolean  @default(false)
  errorMessage        String?  @map("error_message")
  // Phase 3 — Anthropic tool-calling. Captures how many tools the
  // model invoked in this turn and which ones. Empty array = no tool
  // use (most policy-only / chit-chat turns).
  toolUseCount        Int      @default(0) @map("tool_use_count")
  toolNames           String[] @default([]) @map("tool_names")
  createdAt           DateTime @default(now()) @map("created_at")

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation AriaConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([conversationId])
  @@map("aria_query_logs")
}

// Training-data substrate — one immutable, replayable record per assistant
// turn, the atomic unit every future training method (RAG tuning, eval sets,
// DPO from feedback, SFT, tool-use fine-tuning) is built from. Distinct from
// AriaQueryLog (which powers the admin insights page and keeps only
// aggregates): this captures the full turn — the versioned prompt, the RBAC
// snapshot the turn ran under, the retrieved context, the tool calls WITH
// their args + results, and the produced output — so a turn can be
// reconstructed and graded offline.
//
// Written best-effort and gated behind the fail-closed ARIA_TRACE_CAPTURE
// flag, so it never affects chat and stays off until explicitly enabled.
// `userMessage` / `assistantText` / `toolCalls` carry PII; `piiRedacted`
// tracks whether the redaction transform has run (Phase 2), and retention is
// enforced by cron like aria_query_logs. Feedback is NOT copied here — it is
// joined at dataset-build time via `assistantMessageId` → AriaFeedback so the
// trace stays immutable.
model AriaInteractionTrace {
  id                 String   @id @default(uuid()) @db.Uuid
  conversationId     String?  @map("conversation_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  // The persisted assistant message this turn produced — the join key to
  // AriaFeedback (thumbs / correction) at dataset-build time.
  assistantMessageId String?  @map("assistant_message_id") @db.Uuid
  // "send" | "edit" | "retry" — retry/edit turns are valuable negative /
  // preference signal (the prior answer was rejected).
  turnKind           String   @default("send") @map("turn_kind")

  // ── Versioning / model ───────────────────────────────────────────
  // Short digest of the system prompt in force, so a trace is attributable to
  // an exact prompt revision without inlining the whole prompt every turn.
  promptVersion      String   @map("prompt_version")
  model              String
  maxTokens          Int?     @map("max_tokens")

  // ── Input ────────────────────────────────────────────────────────
  userMessage        String   @map("user_message")
  // The actor's permission codes at turn time — lets the dataset builder
  // filter to what the acting role could legitimately see (RBAC-aware
  // training), and reproduce which tools were even offered.
  permissionsSnapshot String[] @default([]) @map("permissions_snapshot")
  offeredTools        String[] @default([]) @map("offered_tools")
  // Retrieved knowledge (ids + aligned cosine distances). Content snapshots /
  // hashes are Phase 2; ids + the corpus are enough to reconstruct v1.
  retrievedArticleIds String[] @default([]) @map("retrieved_article_ids") @db.Uuid
  retrievedDistances  Float[]  @default([]) @map("retrieved_distances")
  topDistance         Float?   @map("top_distance")
  retrievalMode       String   @default("vector") @map("retrieval_mode")
  workspaceBytes      Int      @default(0) @map("workspace_bytes")
  knowledgeBytes      Int      @default(0) @map("knowledge_bytes")

  // ── Output ───────────────────────────────────────────────────────
  assistantText      String   @map("assistant_text")
  stopReason         String?  @map("stop_reason")
  // Full tool trace: [{ name, input, ok, isError, resultPreview }]. The
  // args + results are the tool-use training signal AriaQueryLog throws away
  // (it keeps only count + names). Result payloads are capped on write.
  toolCalls          Json     @default("[]") @map("tool_calls")
  toolUseCount       Int      @default(0) @map("tool_use_count")
  toolNames          String[] @default([]) @map("tool_names")

  // ── Cost / latency / status ──────────────────────────────────────
  tokensIn           Int?     @map("tokens_in")
  tokensOut          Int?     @map("tokens_out")
  cacheReadTokens    Int?     @map("cache_read_tokens")
  cacheCreateTokens  Int?     @map("cache_create_tokens")
  latencyMs          Int      @map("latency_ms")
  error              Boolean  @default(false)
  errorMessage       String?  @map("error_message")

  // ── Governance ───────────────────────────────────────────────────
  piiRedacted        Boolean  @default(false) @map("pii_redacted")

  createdAt          DateTime @default(now()) @map("created_at")

  user             User              @relation("AriaInteractionTraceUser", fields: [userId], references: [id], onDelete: Cascade)
  conversation     AriaConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assistantMessage AriaMessage?      @relation(fields: [assistantMessageId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([conversationId])
  @@index([piiRedacted, createdAt])
  @@map("aria_interaction_traces")
}

// Phase 2 — a versioned, immutable training dataset built from interaction
// traces (+ joined feedback). One row per build; the example rows themselves
// are produced on demand and exported as JSONL. `filters`/`stats` are JSON;
// `checksum` (sha256 of the serialized rows) makes a build verifiable and
// lets a re-build be detected as identical. `version` is monotonic per kind.
model AriaTrainingDataset {
  id          String   @id @default(uuid()) @db.Uuid
  kind        String // "sft" | "dpo" | "eval" | "retrieval"
  version     Int
  format      String   @default("jsonl")
  rowCount    Int      @map("row_count")
  filters     Json     @default("{}")
  stats       Json     @default("{}")
  checksum    String
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  createdBy     User?              @relation("AriaTrainingDatasetAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  modelVersions AriaModelVersion[]

  @@unique([kind, version])
  @@index([kind, createdAt])
  @@map("aria_training_datasets")
}

// Phase 4 — registry of candidate / promoted fine-tunes. The training itself
// runs on external infra; this records lineage (base model, source dataset,
// external job ref) and the eval summary, and gates promotion behind eval
// results (see aria-training eval-gate). Status is a small state machine:
// draft → candidate → promoted | rejected, with archived as a terminal park.
model AriaModelVersion {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  baseModel   String    @map("base_model")
  method      String // "sft" | "dpo" | "prompt"
  datasetId   String?   @map("dataset_id") @db.Uuid
  status      String    @default("draft")
  evalSummary Json      @default("{}") @map("eval_summary")
  externalRef String?   @map("external_ref")
  notes       String?
  createdById String?   @map("created_by_id") @db.Uuid
  promotedAt  DateTime? @map("promoted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  dataset   AriaTrainingDataset? @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  createdBy User?                @relation("AriaModelVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("aria_model_versions")
}

// Phase 8 — proactive daily brief.
//
// Per-user opt-in for ARIA's morning brief. A cron sweeps every hour
// and fires deliveries for any row whose `hourLocal` matches the
// subscriber's current local hour. `sections` is empty by default
// which means "every section the user has permission for"; an
// explicit list lets users mute noisy sections (e.g. drop "pipeline"
// for engineers). `channels` is in_app + email today; slack is
// reserved for a later integration but already part of the contract.
model AriaBriefSubscription {
  userId          String    @id @map("user_id") @db.Uuid
  enabled         Boolean   @default(true)
  hourLocal       Int       @default(7) @map("hour_local")
  timezone        String    @default("Asia/Bangkok")
  channels        String[]  @default(["in_app", "email"])
  // Empty array = "all sections the user has permission to see".
  // Non-empty = explicit allowlist (e.g. ["calendar", "approvals"]).
  sections        String[]  @default([])
  weekdaysOnly    Boolean   @default(false) @map("weekdays_only")
  lastDeliveredAt DateTime? @map("last_delivered_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([enabled, hourLocal])
  @@map("aria_brief_subscriptions")
}

// One row per delivery. `payloadJson` carries the rendered sections so
// the in-app inbox can replay an old brief without re-running the
// builder. `channelStatus` is a `{channel: "ok" | "skipped:<reason>" |
// "error:<code>"}` map so we can spot a Resend outage without trawling
// logs. The unique constraint on (userId, deliveredOn) makes the cron
// idempotent — a re-run inside the same calendar day no-ops.
model AriaBriefDelivery {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  // Calendar date in the subscriber's local timezone. Stored as
  // ISO yyyy-mm-dd string so the unique key survives DST.
  deliveredOn   String   @map("delivered_on")
  generatedAt   DateTime @default(now()) @map("generated_at")
  payloadJson   Json     @map("payload_json")
  channelStatus Json     @default("{}") @map("channel_status")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deliveredOn])
  @@index([userId, generatedAt])
  @@map("aria_brief_deliveries")
}
