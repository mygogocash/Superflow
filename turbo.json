{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "LOG_LEVEL",
    "ACCOUNTING_GL_POSTING",
    "ACCOUNTING_FIXED_ASSETS",
    "ACCOUNTING_SETTLEMENT_V2",
    "NEXT_PUBLIC_ACCOUNTING_FIXED_ASSETS",
    "SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "JWT_SECRET",
    "JWT_REFRESH_SECRET",
    "NODE_ENV",
    "PORT",
    "ALLOWED_ORIGINS",
    "LEAVE_NOTIFICATION_EXCLUDE",
    "ANTHROPIC_API_KEY",
    "GEMINI_API_KEY",
    "RESEND_API_KEY",
    "EMAIL_FROM",
    "NEXT_PUBLIC_APP_URL",
    "GOOGLE_OAUTH_CLIENT_ID",
    "GOOGLE_OAUTH_CLIENT_SECRET",
    "GOOGLE_OAUTH_REDIRECT_URI",
    "BOT_API_CLIENT_ID",
    "BOT_API_BASE_URL",
    "BOT_FX_CURRENCIES",
    "BOT_FX_UNITS",
    "FX_FALLBACK_ENABLED",
    "FX_FALLBACK_BASE_URL",
    "FX_FALLBACK_API_KEY",
    "INTEGRATIONS_TOKEN_KEY",
    "DOCUSIGN_INTEGRATION_KEY",
    "DOCUSIGN_USER_ID",
    "DOCUSIGN_ACCOUNT_ID",
    "DOCUSIGN_RSA_PRIVATE_KEY",
    "DOCUSIGN_AUTH_BASE_URL",
    "DOCUSIGN_API_BASE_URL",
    "DOCUSIGN_HMAC_SECRET",
    "DOCUSIGN_REDIRECT_URI",
    "NEXT_PUBLIC_POSTHOG_KEY",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "POSTHOG_API_KEY",
    "POSTHOG_HOST",
    "POSTHOG_PERSONAL_API_KEY",
    "POSTHOG_PROJECT_ID",
    "NEXT_PUBLIC_TELEMETRY_ENABLED",
    "TELEMETRY_ENABLED",
    "VISA_REMINDER_CC",
    "VISA_90DAY_REMINDER_CC",
    "TRAVEL_APPROVED_CC",
    "VALIDATOR_MONITOR_GITHUB_TOKEN",
    "VALIDATOR_MONITOR_REPO",
    "VALIDATOR_MONITOR_BRANCH",
    "MAGIC_LINK_ALLOWED_ROLES",
    "CORS_ALLOWED_ORIGINS",
    "VALIDATOR_MONITOR_FILE",
    "WEB_BASE_URL",
    "PORTAL_URL",
    "PUBLIC_API_URL",
    "API_URL",
    "NEXT_PUBLIC_API_URL",
    "WORKFLOW_EMAIL_TOKEN_SECRET",
    "DOTENV_PATH",
    "ARIA_PII_RETENTION_DAYS",
    "ARIA_TRACE_CAPTURE",
    "ARIA_TRACE_REDACT_AFTER_DAYS",
    "CRON_SECRET",
    "OW_TRACTION_SHEET_RANGE",
    "OW_TRACTION_SHEET_ID",
    "GOOGLE_SHEETS_SA_KEY",
    "NEXT_PUBLIC_SOCKET_URL",
    "MARKETING_ANALYTICS_ENABLED",
    "NEXT_PUBLIC_MARKETING_ANALYTICS_ENABLED",
    "MARKETING_ANALYTICS_API_URL",
    "MARKETING_ANALYTICS_PARTNER_IDS",
    "MARKETING_ANALYTICS_BACKFILL_FROM",
    "NEXT_PUBLIC_VAPID_PUBLIC_KEY",
    "VAPID_PUBLIC_KEY",
    "VAPID_PRIVATE_KEY",
    "VAPID_SUBJECT",
    "BETTER_AUTH_SECRET",
    "STAGING_DIRECT_URL",
    "CLOUDFLARE_API_TOKEN",
    "CLOUDFLARE_ACCOUNT_ID",
    "EXPO_PUBLIC_APP_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint:fix": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "type-check": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "clean": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    }
  }
}
